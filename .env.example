# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_DEFAULT_LANGUAGE=ko

# Backend
DB_URL=jdbc:mysql://localhost:3306/visafy?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul
DB_USERNAME=visafy
DB_PASSWORD=visafy
AI_SERVICE_URL=http://localhost:8000
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:3000
ADMIN_SECURITY_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-enabling-admin-security
SOURCE_ALLOWED_DOMAINS=kbstar.com,kebhana.com,hanabank.com,shinhan.com,kbsec.com,wooribank.com,ibk.co.kr,nhbank.com,kdb.co.kr,sc.co.kr,citibank.co.kr,kakaobank.com,kbanknow.com,tossbank.com,fss.or.kr,fsc.go.kr,finlife.fss.or.kr
RAG_INTERNAL_TOKEN=change-me-to-an-independent-long-random-token

# AI service
# hash: key-free baseline (default), sentence_transformers: optional local semantic model
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_API_KEY=
LLM_API_KEY=
LLM_MODEL=
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OCR_PROVIDER=none
OCR_API_KEY=
SENTRY_DSN=
VECTOR_DB_PATH=./chroma-data

# MySQL container
MYSQL_DATABASE=visafy
MYSQL_USER=visafy
MYSQL_PASSWORD=visafy
MYSQL_ROOT_PASSWORD=change-me
