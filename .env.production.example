VISAFY_DOMAIN=ssafin.example.com
NEXT_PUBLIC_DEFAULT_LANGUAGE=ko

MYSQL_DATABASE=visafy
MYSQL_USER=visafy
MYSQL_PASSWORD=replace-with-random-secret
MYSQL_ROOT_PASSWORD=replace-with-random-secret
DB_PASSWORD=replace-with-the-same-value-as-mysql-password
ADMIN_USERNAME=replace-with-random-admin-username
ADMIN_PASSWORD=replace-with-random-secret
ADMIN_JWT_SECRET=replace-with-random-secret
RAG_INTERNAL_TOKEN=replace-with-independent-random-secret

LLM_PROVIDER=openai
OPENAI_API_KEY=replace-with-a-new-rotated-openai-project-api-key
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSIONS=384
